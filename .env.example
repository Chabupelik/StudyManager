# ===========================
# Telegram Bot
# ===========================
BOT_TOKEN=1234567890:AAGrAa4b2f2OiT-example
GROUP_ID=-1001234567890

# ===========================
# VK Integration (optional)
# ===========================
VK_GROUP_ID=123456789
VK_CHAT_PEER_ID=2000000001
VK_TOKEN=vk1.a.example_token
# Защищённый ключ VK Mini App: dev.vk.com → Ваше приложение → Настройки → Защищённый ключ
VK_PROTECTED_KEY=

# ===========================
# Admins (comma-separated Telegram IDs)
# ===========================
ADMIN_IDS=123456789,987654321

# ===========================
# AI Logs Auth (SHA-256 hash of the password)
# Generate: echo -n "yourpassword" | sha256sum
# ===========================
AI_LOGS_PASSWORD_HASH=put_sha256_hash_here
LOGS_SECRET_KEY=put_random_64char_hex_here

# ===========================
# Gemini API Keys (semicolon-separated)
# ===========================
API_KEYS=AIzaSy...;AIzaSy...

# ===========================
# JWT
# ===========================
JWT_SECRET=put_random_64char_hex_here

# ===========================
# PostgreSQL
# ===========================
POSTGRES_USER=studymanager
POSTGRES_PASSWORD=strong_password_here
POSTGRES_DB=studymanager_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===========================
# App settings
# ===========================
SHOW_DOCS=False
# The only hardcoded identity: the superadmin's Telegram user ID.
DEVELOPER_ID=620159705
# Deprecated: use group_members table for role management instead.
CURATOR_ID=0

# ===========================
# Internal secret (bot -> backend communication)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# ===========================
INTERNAL_SECRET=put_random_64char_hex_here

# ===========================
# Redis
# ===========================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
